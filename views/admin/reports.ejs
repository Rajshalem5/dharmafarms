<!-- views/admin/reports.ejs — Monthly reports with collection, delivery stats, overdue accounts, CSV export -->
<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-[#1B4332]">Reports</h1>
    <form action="/admin/reports" method="GET">
      <input type="month" name="month" value="<%= reportMonth %>"
             onchange="this.form.submit()"
             class="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2D6A4F] cursor-pointer">
    </form>
  </div>

  <% if (flash) { %>
    <div class="<%= flash.type === 'success' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700' %> border px-4 py-3 rounded-lg mb-4 text-sm">
      <%= flash.message %>
    </div>
  <% } %>

  <!-- Monthly Collection -->
  <div class="bg-white rounded-xl shadow-sm p-5 mb-6 border-l-4 border-l-green-500">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500 mb-1">Total Collected</p>
        <p class="text-3xl font-bold text-[#1B4332] tabular-nums">
          ₹ <%= (+monthlyCollection.totalRupees).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
        </p>
      </div>
      <div class="text-right">
        <p class="text-sm text-gray-500">
          <%= monthlyCollection.paymentCount %> payment<%= monthlyCollection.paymentCount !== 1 ? 's' : '' %> recorded
        </p>
      </div>
    </div>
  </div>

  <!-- Delivery Success Rate -->
  <div class="bg-white rounded-xl shadow-sm p-5 mb-6 border-l-4 border-l-blue-500">
    <%
      var successNum = parseFloat(deliveryStats.successRate);
      var successColor = successNum >= 90 ? 'text-green-600' : (successNum >= 75 ? 'text-amber-600' : 'text-red-600');
    %>
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500 mb-1">Delivery Success Rate</p>
        <p class="text-3xl font-bold <%= successColor %> tabular-nums"><%= deliveryStats.successRate %>%</p>
      </div>
      <div class="text-right">
        <p class="text-sm text-gray-500"><%= deliveryStats.delivered %> delivered out of <%= deliveryStats.total %> total</p>
        <% if (deliveryStats.total > 0) { %>
          <p class="text-xs text-gray-400 mt-1">
            <%= deliveryStats.skipped %> skipped, <%= deliveryStats.issue %> issues, <%= deliveryStats.pending %> pending
          </p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Overdue Accounts -->
  <div class="bg-white rounded-xl shadow-sm p-5 mb-6 border-l-4 border-l-red-500">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-[#1B4332]">Overdue Accounts</h2>
      <span class="<%= overdueAccounts.length > 0 ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %> text-xs font-medium px-2.5 py-0.5 rounded-full">
        <%= overdueAccounts.length %>
      </span>
    </div>

    <% if (overdueAccounts.length === 0) { %>
      <p class="text-gray-500 text-center py-8">No overdue accounts. All customers are up to date.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th>Code</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Balance (Days)</th>
              <th>Rate (Rs)</th>
            </tr>
          </thead>
          <tbody>
            <% overdueAccounts.forEach(function(c) { %>
              <tr>
                <td><%= c.code %></td>
                <td><%= c.name %></td>
                <td><%= c.phone %></td>
                <td class="text-red-600 font-medium tabular-nums"><%= c.balanceDays %></td>
                <td class="tabular-nums">₹ <%= (+c.monthly_rate / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- CSV Export -->
  <div class="bg-white rounded-xl shadow-sm p-5 mb-6">
    <h2 class="text-lg font-semibold text-[#1B4332] mb-4">Export Data</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/admin/reports/export/payments"
         class="inline-flex items-center gap-1.5 px-4 py-2 border border-[#2D6A4F] text-[#2D6A4F] rounded-lg hover:bg-[#2D6A4F] hover:text-white transition-colors duration-150 text-sm font-medium cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Export Payments CSV
      </a>
      <a href="/admin/reports/export/customers"
         class="inline-flex items-center gap-1.5 px-4 py-2 border border-[#2D6A4F] text-[#2D6A4F] rounded-lg hover:bg-[#2D6A4F] hover:text-white transition-colors duration-150 text-sm font-medium cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Export Customers CSV
      </a>
      <a href="/admin/reports/export/deliveries"
         class="inline-flex items-center gap-1.5 px-4 py-2 border border-[#2D6A4F] text-[#2D6A4F] rounded-lg hover:bg-[#2D6A4F] hover:text-white transition-colors duration-150 text-sm font-medium cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Export Deliveries CSV
      </a>
    </div>
  </div>
</div>