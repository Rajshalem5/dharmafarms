<div class="p-6">
  <h1 class="text-2xl font-bold text-[#1B4332] mb-6">Dashboard</h1>

  <% if (!hasDeliveries) { %>
    <div class="bg-white rounded-xl shadow-sm p-8 text-center">
      <p class="text-gray-500 mb-4">No deliveries have been generated for today yet.</p>
      <a href="/admin/dispatch" class="inline-block bg-[#2D6A4F] hover:bg-[#1B4332] text-white font-medium py-2 px-6 rounded-lg transition-colors duration-150">Go to Dispatch</a>
    </div>
  <% } else { %>
    <div class="stats-grid mb-8">
      <div class="stat-card"><div class="stat-card-border" style="background:#1B4332"></div><div class="stat-card-body"><p class="stat-card-count"><%= totals.total %></p><p class="stat-card-label">Total</p></div></div>
      <div class="stat-card"><div class="stat-card-border" style="background:#16a34a"></div><div class="stat-card-body"><p class="stat-card-count"><%= totals.delivered %></p><p class="stat-card-label">Delivered</p></div></div>
      <div class="stat-card"><div class="stat-card-border" style="background:#ca8a04"></div><div class="stat-card-body"><p class="stat-card-count"><%= totals.skipped %></p><p class="stat-card-label">Skipped</p></div></div>
      <div class="stat-card"><div class="stat-card-border" style="background:#dc2626"></div><div class="stat-card-body"><p class="stat-card-count"><%= totals.issue %></p><p class="stat-card-label">Issues</p></div></div>
      <div class="stat-card"><div class="stat-card-border" style="background:#6b7280"></div><div class="stat-card-body"><p class="stat-card-count"><%= totals.pending %></p><p class="stat-card-label">Pending</p></div></div>
      <div class="stat-card"><div class="stat-card-border" style="background:#2563eb"></div><div class="stat-card-body"><p class="stat-card-count"><%= totals.arriving %></p><p class="stat-card-label">Arriving</p></div></div>
      <div class="stat-card"><div class="stat-card-border" style="background:#7c3aed"></div><div class="stat-card-body"><p class="stat-card-count"><%= activeCustomers %></p><p class="stat-card-label">Active Customers</p></div></div>
    </div>

    <% if (boyStats.length > 0) { %>
      <div class="bg-white rounded-xl shadow-sm overflow-hidden mt-6">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-lg font-semibold text-[#1B4332]">Per Delivery Boy</h2>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Delivery Boy</th>
              <th>Total</th>
              <th>Delivered</th>
              <th>Skipped</th>
              <th>Issues</th>
              <th>Arriving</th>
              <th>Pending</th>
            </tr>
          </thead>
          <tbody>
            <% boyStats.forEach(function(b) { %>
              <tr>
                <td class="font-medium"><%= b.boy_name %></td>
                <td><%= b.total %></td>
                <td class="text-green-600 font-medium"><%= b.delivered %></td>
                <td class="text-amber-600"><%= b.skipped %></td>
                <td class="text-red-600"><%= b.issue %></td>
                <td class="text-blue-600"><%= b.arriving %></td>
                <td class="text-gray-500"><%= b.pending %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  <% } %>

  <div class="flex gap-3 mt-6">
    <a href="/admin/dispatch" class="bg-[#2D6A4F] hover:bg-[#1B4332] text-white font-medium py-2 px-6 rounded-lg transition-colors duration-150">View Dispatch</a>
    <a href="/admin/customers" class="bg-white hover:bg-gray-50 text-[#1B4332] font-medium py-2 px-6 rounded-lg border border-gray-300 transition-colors duration-150">Manage Customers</a>
  </div>
</div>