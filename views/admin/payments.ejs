<!-- views/admin/payments.ejs — Payment recording form and per-customer ledger -->
<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-[#1B4332]">Payments</h1>
  </div>

  <% if (flash) { %>
    <div class="<%= flash.type === 'success' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700' %> border px-4 py-3 rounded-lg mb-4 text-sm">
      <%= flash.message %>
    </div>
  <% } %>

  <!-- Payment recording form -->
  <div class="bg-white rounded-xl shadow-sm p-5 mb-6">
    <h2 class="font-semibold text-[#1B4332] mb-4">Record Payment</h2>
    <form action="/admin/payments" method="POST">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div>
          <label for="customer_id" class="block text-sm font-medium text-gray-700 mb-1">Customer *</label>
          <select name="customer_id" id="customer_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2D6A4F]">
            <option value="">-- Select Customer --</option>
            <% customers.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.code %> — <%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">Amount (Rs) *</label>
          <input type="number" name="amount" id="amount" min="0.01" step="0.01" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2D6A4F]" placeholder="0.00">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Mode *</label>
          <div class="flex flex-wrap gap-4 mt-1">
            <% var modes = paymentModes || ['cash', 'upi', 'bank_transfer']; %>
            <% modes.forEach(function(m) { %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="mode" value="<%= m %>" <%= m === 'cash' ? 'checked' : '' %> class="text-[#2D6A4F] focus:ring-[#2D6A4F]">
                <span class="text-sm text-gray-700"><%= m.charAt(0).toUpperCase() + m.slice(1).replace('_', ' ') %></span>
              </label>
            <% }); %>
          </div>
        </div>
        <div>
          <label for="payment_date" class="block text-sm font-medium text-gray-700 mb-1">Payment Date *</label>
          <input type="date" name="payment_date" id="payment_date" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2D6A4F]"
                 value="<%= new Date().toISOString().slice(0, 10) %>">
        </div>
        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
          <textarea name="notes" id="notes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2D6A4F]" placeholder="Optional notes"></textarea>
        </div>
        <div class="flex items-end">
          <button type="submit" class="bg-[#2D6A4F] hover:bg-[#1B4332] text-white font-medium py-2 px-6 rounded-lg transition-colors duration-150 cursor-pointer">Record Payment</button>
        </div>
      </div>
    </form>
  </div>

  <!-- Customer ledger filter -->
  <div class="bg-white rounded-xl shadow-sm p-5 mb-6">
    <h2 class="font-semibold text-[#1B4332] mb-4">View Customer Ledger</h2>
    <form action="/admin/payments" method="GET" class="flex items-end gap-4">
      <div class="flex-1">
        <label for="filter_customer_id" class="block text-sm font-medium text-gray-700 mb-1">Customer</label>
        <select name="customer_id" id="filter_customer_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2D6A4F]">
          <option value="">-- Select Customer --</option>
          <% customers.forEach(function(c) { %>
            <option value="<%= c.id %>"
              <%= (ledger && ledger.customerCode === c.code) ? 'selected' : '' %>>
              <%= c.code %> — <%= c.name %>
            </option>
          <% }); %>
        </select>
      </div>
      <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded-lg transition-colors duration-150 cursor-pointer">View Ledger</button>
    </form>
  </div>

  <!-- Ledger display -->
  <% if (ledger) { %>
    <div class="bg-white rounded-xl shadow-sm p-5 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-[#1B4332]">
          Ledger: <%= ledger.customerCode %> — <%= ledger.customerName %>
        </h2>
      </div>

      <!-- Balance summary -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="stat-card">
          <div class="stat-value"><%= ledger.balance.paidDays %></div>
          <div class="stat-label">Paid Days</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= ledger.balance.consumedDays %></div>
          <div class="stat-label">Consumed Days</div>
        </div>
        <div class="stat-card">
          <div class="stat-value <%= ledger.balance.balanceDays < 0 ? 'text-red-600' : 'text-green-600' %>">
            <%= ledger.balance.balanceDays %>
          </div>
          <div class="stat-label">Balance Days</div>
        </div>
        <div class="stat-card">
          <% if (ledger.balance.isOverdue) { %>
            <span class="badge badge-danger">Overdue</span>
          <% } else { %>
            <span class="badge badge-success">Up to Date</span>
          <% } %>
          <div class="stat-label">Status</div>
        </div>
      </div>

      <!-- Ledger table -->
      <% if (ledger.rows.length === 0) { %>
        <p class="text-gray-500 text-center py-8">No payments recorded for this customer.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Mode</th>
                <th>Amount (₹)</th>
                <th>Notes</th>
                <th>Recorded By</th>
                <th>Running Balance</th>
              </tr>
            </thead>
            <tbody>
              <% ledger.rows.forEach(function(row) { %>
                <tr>
                  <td><%= row.payment_date %></td>
                  <td><%= row.mode.charAt(0).toUpperCase() + row.mode.slice(1).replace('_', ' ') %></td>
                  <td class="font-medium tabular-nums">₹ <%= (+row.amount_rupees).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td><%= row.notes || '-' %></td>
                  <td><%= row.recorded_by || '-' %></td>
                  <td class="font-medium tabular-nums">₹ <%= (+row.runningTotalRupees).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot>
              <tr class="font-bold bg-gray-50">
                <td colspan="5" class="text-right text-sm text-gray-600">Total:</td>
                <td class="tabular-nums">₹ <%= (+ledger.rows[ledger.rows.length - 1].runningTotalRupees).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% } %>
    </div>
  <% } %>
</div>